; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Referee For Fun"
config/description="You are the referee. The game knows the truth. You don't have to tell it."
run/main_scene="res://scenes/match.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/mode=2

[physics]

common/physics_ticks_per_second=120

[rendering]

anti_aliasing/quality/msaa_3d=2
; Needed to export a universal macOS build: Apple Silicon requires ASTC-compressed
; textures, and Godot refuses a universal or arm64 export without this on. The
; alternative was an Intel-only build running under Rosetta on the machine this game
; is developed and played on, which is the wrong way round.
textures/vram_compression/import_etc2_astc=true
